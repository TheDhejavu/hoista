{
  "name": "@hoista/desktop",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Hoista Desktop: the window and menu bar app for Hoista.",
  "license": "MIT",
  "author": "Ayodeji Akinola",
  "homepage": "https://hoista.dev",
  "repository": {
    "type": "git",
