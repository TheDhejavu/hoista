{
 "id": "runpod",
 "name": "Runpod",
 "api": {
  "kind": "rest",
  "base": "",
  "operations": "api_ops.json"
 },
 "cli": {
  "name": "rp",
  "version": "2.1.0",
  "downloads": [
   {
    "platform": "darwin-arm64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-aarch64-apple-darwin.tar.gz",
    "integrity": "sha256-7TNtC6SduO+JsrQf/6NyzmO9Ay8ipW8AHCZYka7DKCk=",
    "inside": "uv-aarch64-apple-darwin/uv"
   },
   {
    "platform": "darwin-x64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-x86_64-apple-darwin.tar.gz",
    "integrity": "sha256-d/XKJsDeIOmSo2d6F0/hEh7iXDb5sUNKhj91vwd6Bes=",
    "inside": "uv-x86_64-apple-darwin/uv"
   },
   {
    "platform": "linux-arm64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-aarch64-unknown-linux-musl.tar.gz",
    "integrity": "sha256-1wza5of+tqrZoJ/o1obfjI769poQB/pYE3miAlrcEKU=",
    "inside": "uv-aarch64-unknown-linux-musl/uv"
   },
   {
    "platform": "linux-x64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-x86_64-unknown-linux-musl.tar.gz",
    "integrity": "sha256-H9BS8ZYQjYfmH8PZj+BrTsdYyaHrFGam/RpDb+RYhfI=",
    "inside": "uv-x86_64-unknown-linux-musl/uv"
   },
   {
    "platform": "windows-arm64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-aarch64-pc-windows-msvc.zip",
    "integrity": "sha256-p0J+oEQLuCa2cW0YN/89FzuOfUlssJ7o9Fa04COi/c0=",
    "archive": "zip",
    "inside": "uv.exe"
   },
   {
    "platform": "windows-x64",
    "url": "https://github.com/astral-sh/uv/releases/download/0.11.32/uv-x86_64-pc-windows-msvc.zip",
    "integrity": "sha256-rP3lcEUc/bhon6FZoTjugFuk4kHEZkMnUDAshiVLCYQ=",
    "archive": "zip",
    "inside": "uv.exe"
   }
  ],
  "inside": "uv",
  "pip": {
   "package": "runpod",
   "version": "2.1.0",
   "module": "runpod.rp_cli.main",
   "python": "3.12",
   "requirements": "requirements.txt"
  },
  "token": "RUNPOD_API_KEY",
  "targets": {
   "app": "app",
   "env": "environment"
  },
  "yes_flag": "yes",
  "commands": "cli.json",
  "context": {
   "env_name": "environment"
  }
 },
 "actions": [
  {
   "label": "Pod details",
   "on": "service",
   "run": "getPod",
   "description": "The pod's GPU, image, ports, status and what it costs an hour.",
   "refs": [
    "pod:"
   ]
  },
  {
   "label": "Endpoint details",
   "on": "service",
   "run": "getEndpoint",
   "description": "The endpoint's workers, GPU pools, scaling and addresses.",
   "refs": [
    "endpoint:"
   ]
  },
  {
   "label": "Workers",
   "on": "service",
   "run": "listEndpointWorkers",
   "description": "The endpoint's workers right now and what each is doing.",
   "refs": [
    "endpoint:"
   ]
  },
  {
   "label": "Volume details",
   "on": "bucket",
   "run": "getNetworkVolume",
   "description": "The volume's size, data center and type.",
   "refs": [
    "volume:"
   ]
  }
 ]
}
