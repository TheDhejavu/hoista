{
 "id": "supabase",
 "name": "Supabase",
 "api": {
  "kind": "rest",
  "base": "/v1",
  "operations": "api_ops.json"
 },
 "cli": {
  "name": "supabase",
  "version": "3.0.0",
  "downloads": [
   {
    "platform": "darwin-arm64",
    "url": "https://registry.npmjs.org/@supabase/cli-darwin-arm64/-/cli-darwin-arm64-3.0.0.tgz",
    "integrity": "sha512-6N/clanDjhKWcPsHBqXcSt7HCZ0bBTjkGGrHgM4834zFu/PBIVBS6u9YJVXxOdQnbwyw/rTwumSYvgwwJgoIug=="
   },
   {
    "platform": "darwin-x64",
    "url": "https://registry.npmjs.org/@supabase/cli-darwin-x64/-/cli-darwin-x64-3.0.0.tgz",
    "integrity": "sha512-e2DKOLIqK82XRp/GSmm0oMXx2CLBSTWJGobro1POPhmn3o+NWRQPI1QvjLFYIeI/9ZfSuo5PUJN4KI9OSjzAng=="
   },
   {
    "platform": "linux-arm64",
    "url": "https://registry.npmjs.org/@supabase/cli-linux-arm64/-/cli-linux-arm64-3.0.0.tgz",
    "integrity": "sha512-sjdzBJGa+zfXSxUczRkqAJpuVgE2PFWXJazYxOnrqYWVPiS9Q0e2m06JdUXwZz/GqxKuLuDQN1OyLFu8DLfQDA=="
   },
   {
    "platform": "linux-x64",
    "url": "https://registry.npmjs.org/@supabase/cli-linux-x64/-/cli-linux-x64-3.0.0.tgz",
    "integrity": "sha512-cR4S5e3nygMaBShbbt6FOiMumtrFJjwdKMXMimC1y7FpxITlwLv36BveaifQZ8aY+v1u+w8oYANU2H72Y4ibWA=="
   },
   {
    "platform": "windows-arm64",
    "url": "https://registry.npmjs.org/@supabase/cli-windows-arm64/-/cli-windows-arm64-3.0.0.tgz",
    "integrity": "sha512-Xox3X7BXpe+/X9XpAgo5/Qrv5qtJaItc3gLlAwJ2d2AcGrBnfh4/b0MvbNbyO7I2Fj1c7yrPmMI4lEicVvIGGw=="
   },
   {
    "platform": "windows-x64",
    "url": "https://registry.npmjs.org/@supabase/cli-windows-x64/-/cli-windows-x64-3.0.0.tgz",
    "integrity": "sha512-nBfd1Rz8MwstIJXHo5fyIQgjmYgLxDbBIuCmuttYAQwTafc7jUOofIAAUUARkhalHu0kBOEyRuEqe2rfKr/l5w=="
   }
  ],
  "inside": "package/bin/supabase",
  "inside_windows": "package/bin/supabase.exe",
  "token": "SUPABASE_ACCESS_TOKEN",
  "variables": {
   "SUPABASE_TELEMETRY_DISABLED": "1",
   "SUPABASE_NO_UPDATE_NOTIFIER": "1",
   "SUPABASE_NO_KEYRING": "1"
  },
  "always": [
   "--output-format=json",
   "--agent=no"
  ],
  "confirmed": [
   "--yes"
  ],
  "targets": {
   "remote": "project"
  },
  "workdir": "--workdir=",
  "commands": "cli.json",
  "context": {
   "function_name": "function"
  }
 },
 "actions": [
  {
   "label": "Apply migrations",
   "on": "database",
   "run": "supabase db push",
   "description": "Applies the migrations in the app's supabase/migrations folder that the database doesn't have yet.",
   "try_first": {
    "dry-run": true
   }
  },
  {
   "label": "Generate types",
   "on": "database",
   "run": "supabase gen types",
   "description": "TypeScript types for the database's tables, views and functions.",
   "args": {
    "lang": "typescript"
   }
  },
  {
   "label": "Check for problems",
   "on": "database",
   "run": "supabase db advisors",
   "description": "Security and performance problems Supabase finds in the database."
  },
  {
   "label": "Table sizes",
   "on": "database",
   "run": "supabase inspect db table-stats",
   "description": "Each table's size, index size and estimated rows."
  },
  {
   "label": "Slowest queries",
   "on": "database",
   "run": "supabase inspect db outliers",
   "description": "Queries that took the most total time."
  },
  {
   "label": "Deploy function",
   "on": "service",
   "run": "supabase functions deploy",
   "description": "Deploys this edge function from the app's supabase/functions folder."
  },
  {
   "label": "Download source",
   "on": "service",
   "run": "supabase functions download",
   "description": "Writes this edge function's deployed code into the app's supabase/functions folder."
  }
 ]
}
