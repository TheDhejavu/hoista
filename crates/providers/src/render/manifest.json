      "postgresid_postgresname": "resource",
      "keyvalueid_keyvaluename": "resource"
    },
    "commands": "cli.json"
  },
  "actions": [
    {
      "label": "Deploys",
      "on": "web",
      "run": "listDeploys",
      "description": "The service's recent deploys, newest first.",
      "args": {
        "limit": 20
      }
    },
    {
      "label": "Recent logs",
      "on": "web",
      "run": "listLogs",
      "description": "The service's latest 100 log lines.",
      "args": {
        "limit": 100
      }
    },
    {
      "label": "Events",
      "on": "web",
      "run": "listEvents",
